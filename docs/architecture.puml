@startuml
title Ventus architecture

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName Helvetica
skinparam packageStyle rectangle
skinparam ArrowColor #5B6B7A
skinparam component {
  BackgroundColor #EDF5FA
  BorderColor #3D6B8A
}
skinparam database {
  BackgroundColor #FFF6DB
  BorderColor #A67820
}

package "Ventus applications" #F5F8FB {
  [SwiftUI apps\niOS / iPadOS / macOS / tvOS / visionOS / watchOS] as apps
  [ForecastDashboardView\nDashboard + animated background] as dashboard
  [WindguruForecastGridView\nFrozen headers + source comparison] as grid
}

package "Forescoop Swift package" #E9F4EC {
  interface "ForecastWindguruProtocol" as protocol
  [ForecastWindguruService\nURLSession REST client] as service
  [ForecastWindguruMockup\nfixture-backed service] as mock
  [Forecast domain\nSpotForecast, models, units\nand weather presentation] as domain
  [Session and location state\nAppStorage + saved map locations] as session
  database "Package resources\nJSON fixtures + service plist" as resources
}

cloud "Windguru public API" as windguru
cloud "Windguru PRO API\nspot and coordinate forecasts" as pro
database "Keychain\nPRO password" as keychain

apps --> protocol
apps --> dashboard
apps --> grid
dashboard --> domain : dashboard and\nper-metric comparison
grid --> domain : blended grid and\nper-model source rows
dashboard --> session
grid --> session
protocol <|.. service
protocol <|.. mock
service --> windguru : forecasts, spots, favorites\nand model metadata
service --> pro : authenticated spot\nand coordinate forecasts
service --> domain : maps responses
mock --> resources : loads fixtures
mock --> domain : maps fixtures
apps --> keychain : stores PRO password only

note right of protocol
Views receive the protocol so previews
and tests can use the mock service.
end note

note bottom of session
The username, selected spot, saved locations,
and model choices are session-aware. The password
stays in Keychain.
end note
@enduml
